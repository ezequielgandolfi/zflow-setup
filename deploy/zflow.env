# zflow settings, read by the zflow-engine and zflow-studio services. Apply changes with: sudo zflow restart

# Where the Studio listens. 0.0.0.0 makes it reachable from other machines on the network.
HOST=0.0.0.0
PORT=4000

# The engine's control API, only used by the Studio. Keep ENGINE_URL in step with CONTROL_PORT.
CONTROL_HOST=127.0.0.1
CONTROL_PORT=4100
ENGINE_URL=http://127.0.0.1:4100

# A folder of extra plugins to load, as an absolute path.
#PLUGINS_DIR=
